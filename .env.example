# Copy to .env — never commit real values.
APP_ENV=dev
SECRET_KEY=change-me-32-bytes-minimum-change-me
FIELD_ENCRYPTION_KEY=            # urlsafe base64 32-byte Fernet key; generate: make keygen
DATABASE_URL=postgresql+asyncpg://rtn:rtn@db:5432/rtn
REDIS_URL=redis://redis:6379/0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                 # e.g. a current Claude model id; read from env only
OIDC_ISSUER=
OIDC_AUDIENCE=
CORS_ORIGINS=http://localhost:3000
DATA_REGION=in-mumbai            # data-residency flag (see docs/COMPLIANCE.md)
RETENTION_DAYS=90
GRIEVANCE_CONTACT=               # DPO / grievance officer email or URL shown to users
DEMO_MODE=true
SOURCES_CONFIG=config/sources.yaml
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_API_URL=http://localhost:8000
