# Copy to .env (make setup does this). Never commit real values.
# NOTE: keep comments on their own lines. Some env-file parsers (Docker Compose) treat text after an empty
# value as part of the value.

APP_ENV=dev
SECRET_KEY=change-me-32-bytes-minimum-change-me

# Fernet key(s) for field-level encryption of Aadhaar / PAN / bank account. Empty = derive a dev key from SECRET_KEY.
# REQUIRED in production. Generate with: make keygen. For rotation use "new,old" (first key encrypts).
FIELD_ENCRYPTION_KEY=

DATABASE_URL=postgresql+asyncpg://rtn:rtn@db:5432/rtn
REDIS_URL=redis://redis:6379/0

# LLM (optional). The model name is read from the environment only; leave empty for the deterministic fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OIDC_ISSUER=
OIDC_AUDIENCE=
CORS_ORIGINS=http://localhost:3000

# Data-residency flag (see docs/COMPLIANCE.md)
DATA_REGION=in-mumbai
RETENTION_DAYS=90

# DPO / grievance officer email or URL shown to users
GRIEVANCE_CONTACT=

DEMO_MODE=true
SOURCES_CONFIG=config/sources.yaml
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_API_URL=http://localhost:8000
