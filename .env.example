# Copy to .env (make setup does this). Never commit real values.
# NOTE: keep comments on their own lines. Some env-file parsers (Docker Compose) treat text after an empty
# value as part of the value.

APP_ENV=dev
SECRET_KEY=change-me-32-bytes-minimum-change-me

# Fernet key(s) for field-level encryption of Aadhaar / PAN / bank account. Empty = derive a dev key from SECRET_KEY.
# REQUIRED in production. Generate with: make keygen. For rotation use "new,old" (first key encrypts).
FIELD_ENCRYPTION_KEY=

DATABASE_URL=postgresql+asyncpg://rtn:rtn@db:5432/rtn
REDIS_URL=redis://redis:6379/0

# LLM (optional). The model name is read from the environment only; leave empty for the deterministic fallback.
# Free options: a local Ollama model, or Google Gemini (free tier). LLM_PROVIDER = auto | ollama | gemini | none
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

OIDC_ISSUER=
OIDC_AUDIENCE=
CORS_ORIGINS=http://localhost:3000

# Data-residency flag (see docs/COMPLIANCE.md)
DATA_REGION=in-mumbai
RETENTION_DAYS=90

# DPO / grievance officer email or URL shown to users
GRIEVANCE_CONTACT=
WEB_BASE_URL=http://localhost:3000

# Outgoing email (optional in dev; leave SMTP_HOST empty to use the labelled in-memory mock)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

DEMO_MODE=true
SOURCES_CONFIG=config/sources.yaml
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_API_URL=http://localhost:8000

# SMS via MSG91 (DLT template with ONE variable; see docs/INTEGRATIONS.md)
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_TEXT_VAR=var1

# Digio: Aadhaar eSign + DigiLocker (leave empty to use the labelled demo mock). Put real values only in .env.prod / Render.
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_ENV=sandbox
DIGIO_WEBHOOK_SECRET=
DIGIO_WEBHOOK_IPS=
DIGIO_DIGILOCKER_TEMPLATE=DIGILOCKER_AADHAAR_PAN

# Document Vault storage (local | s3). In local dev, files are stored in STORAGE_LOCAL_DIR.
# In production with S3-compatible object storage (AWS S3, Cloudflare R2, MinIO), set STORAGE_BACKEND=s3.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/vault
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=5242880

# Document Vault malware scanning (disabled | external).
# When DOCUMENT_SCAN_MODE=external, uploads are scanned via DOCUMENT_SCAN_URL before storage.
DOCUMENT_SCAN_MODE=disabled
DOCUMENT_SCAN_URL=
