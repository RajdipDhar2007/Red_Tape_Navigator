# Production settings for docker-compose.prod.yml. Copy to .env.prod. NEVER commit .env.prod.
# Keep comments on their own lines.

# Public hostnames (DNS A/AAAA records must point at this server)
WEB_DOMAIN=navigator.example.gov.in
API_DOMAIN=api.navigator.example.gov.in

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# make keygen   (Fernet key; losing it makes stored Aadhaar/PAN answers unreadable - back it up in the secret manager)
FIELD_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Data-protection grievance officer (email or URL) shown to citizens - required
GRIEVANCE_CONTACT=

# Outgoing email (password reset + reminders). Use a verified sender domain (SPF/DKIM).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@navigator.example.gov.in

# Optional
METRICS_TOKEN=
# Free options: a local Ollama model, or Google Gemini (free tier). LLM_PROVIDER = auto | ollama | gemini | none
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
SENTRY_DSN=
RETENTION_DAYS=90
DATA_REGION=in-mumbai

# SMS via MSG91 (DLT template with ONE variable; see docs/INTEGRATIONS.md)
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_TEXT_VAR=var1

# Digio: Aadhaar eSign + DigiLocker (leave empty to use the labelled demo mock). Put real values only in .env.prod / Render.
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_ENV=sandbox
DIGIO_WEBHOOK_SECRET=
DIGIO_WEBHOOK_IPS=
DIGIO_DIGILOCKER_TEMPLATE=DIGILOCKER_AADHAAR_PAN

# Single server without the worker container: run reminders, retention purge and weekly re-checks inside the API (one instance only).
# docker-compose.prod.yml starts a worker, so leave this false there.
RUN_SCHEDULER=false
