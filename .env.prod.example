# Production settings for docker-compose.prod.yml. Copy to .env.prod. NEVER commit .env.prod.
# Keep comments on their own lines.

# Public hostnames (DNS A/AAAA records must point at this server)
WEB_DOMAIN=navigator.example.gov.in
API_DOMAIN=api.navigator.example.gov.in

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# make keygen   (Fernet key; losing it makes stored Aadhaar/PAN answers unreadable - back it up in the secret manager)
FIELD_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Data-protection grievance officer (email or URL) shown to citizens - required
GRIEVANCE_CONTACT=

# Outgoing email (password reset + reminders). Use a verified sender domain (SPF/DKIM).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@navigator.example.gov.in

# Optional
METRICS_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
SENTRY_DSN=
RETENTION_DAYS=90
DATA_REGION=in-mumbai

# SMS via MSG91 (DLT template with ONE variable; see docs/INTEGRATIONS.md)
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_TEXT_VAR=var1
